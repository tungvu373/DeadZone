gitattributes
# Mặc định: tự động chuẩn hóa text file về LF trong repo
* text=auto

# Các file Unity dạng text (YAML) → luôn dùng LF
*.cs text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.shader text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.shadergraph text eol=lf
*.inputactions text eol=lf
*.json text eol=lf
*.txt text eol=lf

# File nhị phân → KHÔNG bao giờ đụng vào line ending
*.png binary
*.jpg binary
*.jpeg binary
*.psd binary
*.tga binary
*.ttf binary
*.otf binary
*.fbx binary
*.wav binary
*.mp3 binary
*.ogg binary
*.dll binary