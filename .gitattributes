# ========================================
# General text normalization
# ========================================

* text=auto

# Unity text/YAML files
*.cs text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.shader text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.shadergraph text eol=lf
*.inputactions text eol=lf
*.json text eol=lf
*.txt text eol=lf

# ========================================
# Binary files
# ========================================

*.png binary
*.jpg binary
*.jpeg binary
*.psd binary
*.tga binary
*.ttf binary
*.otf binary
*.fbx binary
*.wav binary
*.mp3 binary
*.ogg binary
*.dll binary

# ========================================
# Git LFS
# Only large Firebase binaries
# ========================================

Assets/Firebase/Plugins/x86_64/FirebaseCppApp-13_14_0.so filter=lfs diff=lfs merge=lfs -text
Assets/Firebase/Plugins/x86_64/FirebaseCppApp-13_14_0.bundle filter=lfs diff=lfs merge=lfs -text